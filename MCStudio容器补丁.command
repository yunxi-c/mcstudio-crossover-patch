4wMAAAA="""
EXPECTED = "f74fcc9473876921a882c43f2faab459f9e2f91653ebcd1c9f37fcbb0726ce34"
blob = base64.b64decode(PAYLOAD)
if hashlib.sha256(blob).hexdigest() != EXPECTED:
    raise SystemExit("脚本内置资源校验失败，未修改。")
args = sys.argv[1:]
if not args or (args[0] in ("install", "launch", "rollback", "status") and "--bottle" not in args):
    sys.stdin = open("/dev/tty", "r")
interactive = not args
try:
    with tempfile.TemporaryDirectory(prefix="modpc-container-patch-") as temp:
        directory = pathlib.Path(temp)
        with zipfile.ZipFile(io.BytesIO(blob)) as archive:
            for member in archive.infolist():
                path = pathlib.PurePosixPath(member.filename)
                if path.is_absolute() or ".." in path.parts:
                    raise ValueError("资源路径无效。")
            archive.extractall(directory)
        if args and args[0] == "--extract-source":
            if len(args) != 2:
                raise ValueError("用法：--extract-source 新目录路径")
            target = pathlib.Path(args[1]).expanduser()
            if target.exists():
                raise ValueError("导出目录已存在，未覆盖。")
            shutil.copytree(directory, target)
            print("源码、驱动和许可证已导出到：" + str(target))
        else:
            if interactive:
                print("MCStudio 容器 OpenGL 实验补丁")
                bottle_root = pathlib.Path.home() / "Library/Application Support/CrossOver/Bottles"
                if not bottle_root.is_dir():
                    raise ValueError("没有找到已创建的 CrossOver 容器。")
                bottles = sorted(p.name for p in bottle_root.iterdir() if (p / "cxbottle.conf").is_file())
                if not bottles:
                    raise ValueError("没有找到已创建的 CrossOver 容器。")
                print("1. 选择容器")
                for number, name in enumerate(bottles, 1):
                    print(str(number) + ". " + name)
                selected = input("输入容器编号：").strip()
                if not selected.isdigit() or not 1 <= int(selected) <= len(bottles):
                    raise ValueError("未选择有效容器，未修改。")
                bottle = bottles[int(selected) - 1]
                print("已选择容器：" + bottle)
                print("2. 选择操作\n1. 注入\n2. 移除")
                operation = input("输入操作编号：").strip()
                if operation not in ("1", "2"):
                    raise ValueError("未选择有效操作，未修改。")
                args = ["install" if operation == "1" else "rollback", "--bottle", bottle]
            if args is not None:
                sys.argv = [str(directory / "manage.py"), *args]
                runpy.run_path(str(directory / "manage.py"), run_name="__main__")
except (ValueError, OSError, EOFError, KeyboardInterrupt) as error:
    print("未完成：" + str(error), file=sys.stderr)
    sys.exit(1)
finally:
    if interactive and sys.stdin.isatty():
        try: input("按回车关闭。")
        except (EOFError, KeyboardInterrupt): pass
MODPC_PYTHON
